---
interface Review {
	quote: string;
	name: string;
	source: string;
}

interface Props {
	eyebrow?: string;
	title?: string;
	rating?: string;
	count?: string;
	reviews?: Review[];
}

const {
	eyebrow = 'Reviews',
	title = 'Good words belong to real customers.',
	rating = '[VERIFIED REVIEW RATING]',
	count = '[VERIFIED REVIEW COUNT]',
	reviews = [
		{ quote: '[Add an approved customer review here.]', name: '[CUSTOMER NAME]', source: '[REVIEW SOURCE / DATE]' },
		{ quote: '[Add an approved customer review here.]', name: '[CUSTOMER NAME]', source: '[REVIEW SOURCE / DATE]' },
		{ quote: '[Add an approved customer review here.]', name: '[CUSTOMER NAME]', source: '[REVIEW SOURCE / DATE]' },
	],
} = Astro.props;
---

<section class="reviews section" id="reviews" aria-labelledby="reviews-title">
	<div class="container">
		<div class="reviews__heading"><div><p class="eyebrow">{eyebrow}</p><h2 class="section-heading" id="reviews-title">{title}</h2></div><div class="rating"><span aria-hidden="true">“</span><p><strong class="placeholder">{rating}</strong><small>From <span class="placeholder">{count}</span> verified reviews</small></p></div></div>
		<div class="review-grid">
			{reviews.map((review) => (
				<figure class="review-card"><span class="review-card__quote" aria-hidden="true">“</span><blockquote>{review.quote}</blockquote><figcaption><span class="review-card__avatar" aria-hidden="true">E</span><span><strong class="placeholder">{review.name}</strong><small class="placeholder">{review.source}</small></span></figcaption></figure>
			))}
		</div>
		<p class="reviews__note">Placeholder reviews shown for layout only. Replace with real, approved customer feedback and verified ratings.</p>
	</div>
</section>

<style>
	.section { padding-block: clamp(4.5rem, 8vw, 7.2rem); }
	.reviews { background: #efeee7; }
	.reviews__heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.2rem; }
	.reviews__heading > div:first-child { max-width: 680px; }
	.rating { display: flex; align-items: center; gap: 0.7rem; padding: 0.8rem 0.95rem; border: 1px solid #d7d8cf; border-radius: 0.55rem; background: rgb(255 254 250 / 72%); }
	.rating > span { color: #8c9e98; font-family: Georgia, serif; font-size: 2.2rem; line-height: 0.7; }
	.rating p, .rating strong, .rating small { display: block; margin: 0; }
	.rating strong { font-size: 0.71rem; }
	.rating small { margin-top: 0.3rem; color: var(--color-muted); font-size: 0.6rem; }
	.review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
	.review-card { display: flex; min-height: 16rem; flex-direction: column; align-items: flex-start; margin: 0; padding: 1.2rem; border: 1px solid #dcddd5; border-radius: 0.65rem; background: var(--color-white); }
	.review-card__quote { color: #77938b; font-family: Georgia, serif; font-size: 2.6rem; line-height: 0.9; }
	.review-card blockquote { margin: 0.9rem 0 1.3rem; color: var(--color-ink); font-family: var(--font-display); font-size: 1.08rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.55; }
	.review-card figcaption { display: flex; align-items: center; gap: 0.6rem; margin-top: auto; }
	.review-card__avatar { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 50%; color: #385e61; background: #dce7e1; font-size: 0.75rem; font-weight: 700; }
	.review-card figcaption strong, .review-card figcaption small { display: block; }
	.review-card figcaption strong { font-size: 0.64rem; }
	.review-card figcaption small { margin-top: 0.2rem; border-color: #c9c4b4; font-size: 0.55rem; }
	.reviews__note { margin: 1rem 0 0; color: var(--color-muted); font-size: 0.65rem; }
	@media (max-width: 760px) { .reviews__heading { align-items: flex-start; flex-direction: column; gap: 1rem; } .review-grid { grid-template-columns: 1fr 1fr; } .review-card:last-child { grid-column: span 2; min-height: 13rem; } }
	@media (max-width: 540px) { .review-grid { grid-template-columns: 1fr; } .review-card:last-child { grid-column: auto; } .review-card { min-height: 13rem; } }
</style>
