---
interface Props {
	city?: string;
	state?: string;
	eyebrow?: string;
	title?: string;
	copy?: string;
	imageAlt?: string;
}

const {
	city = 'Naples',
	state = 'Florida',
	eyebrow = 'Local exterior care',
	title = 'A Naples home deserves a thoughtful clean.',
	copy = 'From tiled roofs to lanai screens and pavers, a considered cleaning plan starts with the surface. Use this space to explain the team’s local connection and approach.',
	imageAlt = 'Illustration of a Naples-style home with a tiled roof and screened lanai',
} = Astro.props;
---

<section class="about section" id="about" aria-labelledby="about-title">
	<div class="container about__grid">
		<div class="about__visual">
			<div class="visual__label">{city} <span>·</span> {state}</div>
			<svg viewBox="0 0 560 475" role="img" aria-label={imageAlt}>
				<rect width="560" height="475" fill="#e8ede7" />
				<circle cx="435" cy="100" r="43" fill="#e0cfaa" />
				<path d="M0 340c83-40 153-42 233-17 94 29 190-30 327-17v169H0V340Z" fill="#bed0c4" />
				<path d="M111 220 278 99l160 116v169H111V220Z" fill="#fffefa" />
				<path d="m92 220 186-140 179 135" fill="none" stroke="#9a6e60" stroke-width="17" stroke-linecap="round" stroke-linejoin="round" />
				<path d="m122 218 156-117 149 113" fill="none" stroke="#c89b7f" stroke-width="4" />
				<path d="M149 230h78v66h-78zM245 230h66v66h-66z" fill="#c8ddd8" />
				<path d="M188 230v66m-39-33h78m51-33v66m-33-33h66" stroke="#557480" stroke-width="4" />
				<path d="M330 218h76v166h-76z" fill="#f1eee6" stroke="#5b7882" stroke-width="3" />
				<path d="M355 218v166m26-166v166m25-166v166m-76-113h76m-76 57h76" stroke="#80999b" stroke-width="2" />
				<path d="M239 384v-61a37 37 0 0 1 74 0v61" fill="#d8e4da" />
				<path d="M270 351h2" stroke="#557480" stroke-width="4" stroke-linecap="round" />
				<path d="M71 390c0-49 25-79 48-93 27 15 47 47 44 91-2 33-21 51-47 58-26-4-43-23-45-56Z" fill="#6e9485" />
				<path d="M121 451V316m2 56 31-26m-32 58-27-29" fill="none" stroke="#315c58" stroke-width="4" stroke-linecap="round" />
				<path d="M20 398c111-18 188 8 287 9 82 1 147-17 233-11" fill="none" stroke="#fffefa" stroke-width="3" stroke-dasharray="2 8" />
			</svg>
			<div class="surface-note"><span class="surface-note__mark" aria-hidden="true">✳</span><span><small>Designed for the outdoors</small><strong>Roof · Pavers · Lanai</strong></span></div>
		</div>
		<div class="about__copy">
			<p class="eyebrow">{eyebrow} · {city}, {state}</p>
			<h2 class="section-heading" id="about-title">{title}</h2>
			<p class="section-copy">{copy}</p>
			<p class="about__placeholder"><span class="placeholder">Add owner introduction</span> Share a real local detail here—how the business came to serve Naples, and what care looks like on each surface.</p>
			<a class="about__link" href="#service-areas">See the service area <span aria-hidden="true">↓</span></a>
		</div>
	</div>
</section>

<style>
	.section { padding-block: clamp(4.5rem, 8vw, 7.2rem); }
	.about { background: #efeee7; }
	.about__grid { display: grid; grid-template-columns: 1.02fr 0.88fr; align-items: center; gap: clamp(3rem, 8vw, 7rem); }
	.about__visual { position: relative; width: min(100%, 520px); }
	.about__visual > svg { width: 100%; border-radius: 44% 44% 0.85rem 0.85rem / 28% 28% 0.85rem 0.85rem; }
	.visual__label { position: absolute; top: 1rem; left: 1rem; z-index: 1; padding: 0.6rem 0.8rem; border: 1px solid rgb(23 55 71 / 8%); border-radius: 99px; color: var(--color-ink-soft); background: rgb(255 254 250 / 92%); font-size: 0.68rem; font-weight: 700; }
	.visual__label span { padding-inline: 0.15rem; color: #688f86; }
	.surface-note { position: absolute; right: -1rem; bottom: 1.5rem; display: flex; align-items: center; gap: 0.65rem; padding: 0.85rem 1rem; border: 1px solid rgb(23 55 71 / 7%); border-radius: 0.7rem; background: var(--color-white); box-shadow: var(--shadow-card); }
	.surface-note__mark { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: 50%; color: #37665f; background: #d8e7df; font-size: 1.1rem; }
	.surface-note small, .surface-note strong { display: block; }
	.surface-note small { margin-bottom: 0.2rem; color: var(--color-muted); font-size: 0.62rem; }
	.surface-note strong { font-family: var(--font-display); font-size: 0.78rem; font-weight: 600; }
	.about__copy { max-width: 510px; }
	.about__copy .eyebrow { margin-bottom: 1rem; }
	.about__placeholder { display: grid; justify-items: start; gap: 0.45rem; margin: 1.35rem 0 0; color: var(--color-muted); font-size: 0.84rem; line-height: 1.65; }
	.about__link { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.5rem; color: var(--color-ink); font-size: 0.82rem; font-weight: 700; text-decoration: none; }
	.about__link:hover { text-decoration: underline; text-underline-offset: 0.2em; }
	@media (max-width: 760px) { .about__grid { grid-template-columns: 1fr; gap: 3rem; } .about__visual { width: min(100%, 520px); margin-inline: auto; } .about__copy { max-width: 600px; } }
	@media (max-width: 440px) { .surface-note { right: -0.3rem; bottom: 0.8rem; padding: 0.65rem 0.75rem; } .surface-note__mark { width: 1.9rem; height: 1.9rem; } }
</style>
